{
  "name": "tape4fun",
  "version": "1.0.0",
  "description": "An independent bilingual reference to TapeOut infrastructure and valuable products across its surrounding ecosystem.",
  "scripts": {
    "dev": "http-server . -p 8000 -c-1",
    "build": "npm run build:web",
    "build:web": "node scripts/build.mjs --target=web",
    "build:chain": "node scripts/build.mjs --target=chain",
    "test:build": "node --test scripts/build.test.mjs",
    "test:share": "node --test scripts/share.test.mjs",
    "preview": "npm run preview:web",
    "preview:web": "http-server dist/web -p 8000 -c-1",
    "preview:chain": "http-server dist/chain -p 8000 -c-1"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "http-server": "^14.1.1",
    "sharp": "^0.35.5",
    "svgo": "^3.3.5",
    "terser": "^5.51.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.9"
  }
}
